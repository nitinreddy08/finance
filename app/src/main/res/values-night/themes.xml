<resources>
    <!-- Dark variant of the pre-Compose window theme — parented on the dark Material style so
         system-drawn chrome (e.g. a brief flash before BudgetPaceTheme's first composition)
         doesn't render dark text on a dark window. -->
    <style name="Theme.BudgetPace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
