<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required on API 33+ to post the categorization notification (spec §21). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Without this, no network call can succeed at all: Google sign-in token verification,
         Drive/Sheets authorization and API calls, and WorkManager's network-constrained sync
         worker would all silently fail. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Primary capture path. Android 15 replaces notification text with "Sensitive notification
         content hidden" whenever it detects an OTP-like number, and a 12-digit UPI reference
         qualifies, so a notification listener cannot read bank SMS on this device at all. Reading
         the SMS itself is unaffected. Note this permission is hard-restricted: fine for a
         sideloaded build, disqualifying for Play Store distribution. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- So the app can ask to be left running in the background; OxygenOS otherwise stops
         delivering to a listener once the phone is unplugged. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (API 30+): used only to tell whether this OEM actually has an
         autostart screen before offering to open it. -->
    <queries>
        <package android:name="com.oneplus.security" />
        <package android:name="com.coloros.safecenter" />
    </queries>

    <application
        android:name=".BudgetPaceApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetPace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS_RECEIVED is exempt from the implicit-broadcast limits, so this is delivered even
             when the process is dead — the case a notification listener cannot survive on this
             OEM. Requiring BROADCAST_SMS (a signature permission) means only the platform
             telephony stack can trigger it, never another app. -->
        <receiver
            android:name=".sms.BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Kept as a fallback for messages the SMS path misses; Android may redact its text. -->
        <service
            android:name=".notification.listener.SmsNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- A listener is unbound by an app update and is not always rebound on its own. -->
        <receiver
            android:name=".notification.listener.ListenerRebindReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lets an exported CSV be handed to another app; a file:// Uri would throw on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".notification.presenter.CategorizationActionReceiver"
            android:exported="false" />

        <!-- WorkManager's default ContentProvider-based auto-init runs before
             Application.onCreate() — before Hilt has injected BudgetPaceApp's fields — so it
             would crash reading workManagerConfiguration. Disable it here; BudgetPaceApp
             initializes WorkManager manually instead, after super.onCreate(). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
